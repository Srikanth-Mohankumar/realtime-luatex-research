% rtcapture.sty — load the context-capture pass into a full compile.
% Usage: \usepackage{rtcapture} in the sample document (after the class).
% Plant \RTpara{<id>} before each body paragraph you want keyed for the
% fast path; ids appear as node attributes in the capture output.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{rtcapture}[2026/07/21 v0.1 context capture for real-time LuaTeX]
% locate capture.lua via kpathsea (the engine dir is on TEXINPUTS)
\directlua{RTCAPTURE = dofile(assert(kpse.find_file("capture.lua", "tex"),
  "rtcapture: capture.lua not found on TEXINPUTS"))}
\newcommand\RTpara[1]{\directlua{RTCAPTURE.setpara(#1)}}
% production markup: \paraid{para10} at paragraph start -> attribute via a
% string->int registry (written to the capture JSON as "ids").
% CHAIN any existing production \paraid (e.g. neopage-apg.sty's) — its
% bookkeeping must keep running; we only add the attribute.
\AtBeginDocument{%
  \ifcsname paraid\endcsname
    \expandafter\let\expandafter\rtc@origparaid\csname paraid\endcsname
  \else
    \let\rtc@origparaid\@gobble
  \fi
  \gdef\paraid#1{%
    \directlua{RTCAPTURE.setparaid("\luaescapestring{#1}")}%
    \rtc@origparaid{#1}}%
}
\AtBeginDocument{\directlua{RTCAPTURE.start()}}
% \clearpage first: the final page must ship before we write the capture
\AtEndDocument{\clearpage\directlua{RTCAPTURE.finish(tex.jobname .. "-capture.json")}}
